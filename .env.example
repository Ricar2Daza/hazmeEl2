# ==============================
# BACKEND ENVIRONMENT VARIABLES
# (Copiar este archivo a ./backend/.env y rellenar valores)
# ==============================

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hazme?schema=public"

# JWT Auth
JWT_SECRET="tu-secreto-jwt-super-seguro-cambiar-en-produccion"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"

# SMTP / Email (mockeado en MVP: solo log)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"
EMAIL_FROM="no-reply@hazme.com"

# Frontend URLs (para links de verificación)
WEB_URL="http://localhost:5173"
MOBILE_URL="exp://192.168.1.100:8081"
