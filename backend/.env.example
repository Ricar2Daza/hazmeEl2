# Copia este archivo a `.env` y ajusta los valores.
# cp .env.example .env

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hazme?schema=public"

# JWT Auth
JWT_SECRET="tu-secreto-jwt-super-seguro-cambiar-en-produccion"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS (orígenes permitidos para el backend; con el proxy de Vite la web es
# same-origin y no necesita CORS, pero el móvil sí usa un origen propio).
# En desarrollo, además de esta lista se aceptan localhost y los túneles de
# ngrok (*.ngrok-free.dev / *.ngrok.dev), cuyo subdominio cambia en cada
# sesión; en producción sólo se respeta la lista de abajo.
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"

# SMTP / Email (mockeado en MVP: solo se imprime en la consola del backend)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="changeme"
EMAIL_FROM="no-reply@hazme.com"

# URLs de los frontends (usadas para armar los links de verificación)
WEB_URL="http://localhost:5173"
MOBILE_URL="exp://192.168.1.100:8081"

# Verificación de email por enlace:
#   false => las cuentas nacen verificadas y se puede entrar directo.
#            NECESARIO mientras el SMTP esté mockeado (si no, nadie puede
#            verificar su email y el login devuelve 403).
#   true  => comportamiento original: bloquea el login hasta verificar.
EMAIL_VERIFICATION_REQUIRED=false
