generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  ABIERTO
  EN_PROGRESO
  FINALIZADO
  CANCELADO
}

enum ApplicationStatus {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

enum NotificationType {
  NEW_APPLICATION
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  JOB_UPDATED
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  fullName         String
  emailVerified    Boolean        @default(false)
  verificationToken String?
  refreshToken     String?
  phone            String?
  companyName      String?
  portfolioUrl     String?
  bio              String?
  experienceYears  Int?
  skills           String[]       @default([])
  locationAddress  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  publishedJobs    Job[]
  myApplications   Application[]
  notifications    Notification[]
  chatMessages     ChatMessage[]
  directMessages   DirectMessage[]
  givenRatings     Rating[]         @relation("RatingsGiven")
  receivedRatings  Rating[]         @relation("RatingsReceived")
  conversationsA   Conversation[]   @relation("ConversationA")
  conversationsB   Conversation[]   @relation("ConversationB")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  jobs        Job[]
}

model Job {
  id              String         @id @default(uuid())
  title           String
  description     String
  locationAddress String
  budgetMin       Int
  budgetMax       Int
  deadlineDate    DateTime
  categoryId      String
  publisherId     String
  status          JobStatus      @default(ABIERTO)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  publisher       User           @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  applications    Application[]
  relatedNotifications Notification[] @relation("JobNotifications")
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  applicantId String
  message     String?
  status      ApplicationStatus @default(PENDIENTE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant   User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  chatMessages ChatMessage[]

  @@unique([jobId, applicantId])
}

model ChatMessage {
  id            String      @id @default(uuid())
  applicationId String
  senderId      String
  content       String      @db.VarChar(2000)
  createdAt     DateTime    @default(now())
  /// Recibo de entrega: el cliente del receptor confirmó recepción (MQTT/REST).
  deliveredAt   DateTime?
  /// Recibo de lectura: el receptor tenía el hilo abierto y vio el mensaje.
  readAt        DateTime?

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  type          NotificationType
  title         String
  message       String
  relatedJobId  String?
  read          Boolean          @default(false)
  createdAt     DateTime         @default(now())

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedJob    Job?             @relation("JobNotifications", fields: [relatedJobId], references: [id], onDelete: SetNull)
}

/// Valoración de un usuario a otro (reputación). Una sola por par rater→rated.
model Rating {
  id        String   @id @default(uuid())
  raterId   String
  ratedId   String
  score     Int
  comment   String?  @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  rated     User     @relation("RatingsReceived", fields: [ratedId], references: [id], onDelete: Cascade)

  @@unique([raterId, ratedId])
  @@index([ratedId, createdAt])
}

/// Conversación directa entre dos usuarios (fuera de una postulación).
/// Los participantes se guardan normalizados (userAId < userBId) para que
/// el par sea único y no se dupliquen hilos en los dos sentidos.
model Conversation {
  id        String          @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  userA     User            @relation("ConversationA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User            @relation("ConversationB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  DirectMessage[]

  @@unique([userAId, userBId])
  @@index([updatedAt])
}

model DirectMessage {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String       @db.VarChar(2000)
  createdAt      DateTime     @default(now())
  /// Recibo de entrega: el cliente del receptor confirmó recepción (MQTT/REST).
  deliveredAt    DateTime?
  /// Recibo de lectura: el receptor tenía el hilo abierto y vio el mensaje.
  readAt         DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
